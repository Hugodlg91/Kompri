# Normalize all text files to LF across all platforms
* text=auto eol=lf

# Rust, TypeScript, React, JSON, Markdown, CSS, HTML, YAML, NSIS
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.nsh text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.xml text eol=lf

# Binary assets — never modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.bmp binary
*.tiff binary
*.tif binary
*.gif binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.msi binary
*.dmg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.xz binary
